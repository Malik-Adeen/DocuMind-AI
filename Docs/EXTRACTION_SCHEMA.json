{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal/doc-intel/extraction-schema-0.3.1.json",
  "title": "ExtractionResult",
  "description": "The only shape an extraction result ever takes. LLM output, DB row, API response and Excel columns all derive from this. Field declaration order defines Excel column order.",
  "type": "object",
  "required": ["document_id", "pipeline_version", "document_type", "fields", "status"],
  "additionalProperties": false,

  "$defs": {
    "source": {
      "type": "object",
      "description": "Provenance. A field with no source is a bug, not a low-confidence result (INV-2).",
      "required": ["origin"],
      "additionalProperties": false,
      "properties": {
        "origin": { "enum": ["ocr_latin", "ocr_urdu", "llm_inferred", "human", "computed"] },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "description": "[x0, y0, x1, y1] normalised 0..1",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 4,
          "maxItems": 4
        },
        "raw_text": { "type": "string" },
        "unmatched": {
          "type": "boolean",
          "description": "True only when raw_text was claimed (origin llm_inferred) but no exact substring match was found in the OCR text — a fabricated or misquoted citation, categorically different from a field that simply has no gate covering it. Omitted, never false, when not applicable. Orchestrator-owned (app/pipeline/provenance.py); a model that outputs this key has it discarded and recomputed, same as verified/gate/gate_error (new in 0.3.1)."
        }
      }
    },

    "field": {
      "type": "object",
      "required": ["value", "confidence", "verified", "source"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "verified": {
          "type": "boolean",
          "description": "True only if a deterministic gate confirmed it, or a human corrected it. Distinct from high confidence. A gate whose result is format_only can never set this true — a format check cannot prove a well-formed value is the correct value."
        },
        "gate": {
          "type": ["string", "null"],
          "description": "Which validator ran, e.g. iban_checksum, cnic_format_check, arithmetic_reconciliation, date_parse, none"
        },
        "gate_error": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" }
      }
    },

    "money_field": {
      "allOf": [{ "$ref": "#/$defs/field" }],
      "description": "value is a decimal string, e.g. '45000.00'. Never a float — no binary rounding on billing numbers.",
      "properties": {
        "value": { "type": ["string", "null"], "pattern": "^-?[0-9]+\\.[0-9]{2}$" }
      }
    }
  },

  "properties": {
    "document_id": { "type": "string", "format": "uuid" },
    "extraction_id": { "type": "string", "format": "uuid" },
    "pipeline_version": {
      "type": "object",
      "description": "Stamped on every extraction. Two results are only comparable if these match — including profile, because the same document extracted on prototype and on production went through different models on different hardware.",
      "required": ["profile", "ocr_latin", "ocr_urdu", "llm", "prompt_hash"],
      "properties": {
        "profile": {
          "enum": ["prototype", "production"],
          "description": "Deployment profile the extraction ran under. prototype uses a hosted LLM and is restricted to public/synthetic documents; production is all-local. Without this field two extractions of the same document under the two profiles compare as equivalent, which they are not (INV-6, ADR-006)."
        },
        "ocr_latin": { "type": "string", "examples": ["paddleocr-pp-ocrv5"] },
        "ocr_urdu": { "type": "string", "examples": ["qaari-0.1-urdu"] },
        "llm": { "type": "string", "examples": ["qwen2.5-7b-instruct"] },
        "prompt_hash": { "type": "string" },
        "schema_version": { "type": "string", "const": "0.3.1" }
      }
    },
    "status": { "enum": ["complete", "needs_review", "failed"] },
    "document_type": {
      "type": "object",
      "required": ["value", "confidence"],
      "properties": {
        "value": { "enum": ["invoice", "purchase_order", "contract", "quotation", "billing_sheet", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "language": {
      "type": "object",
      "properties": {
        "primary": { "enum": ["en", "ur", "mixed", "unknown"] },
        "confidence": { "type": "number" }
      }
    },

    "fields": {
      "type": "object",
      "description": "Declaration order here IS the Excel column order.",
      "additionalProperties": false,
      "properties": {
        "po_number":        { "$ref": "#/$defs/field" },
        "invoice_number":   { "$ref": "#/$defs/field" },
        "customer_name":    { "$ref": "#/$defs/field" },
        "vendor_name":      { "$ref": "#/$defs/field" },
        "cnic":             { "$ref": "#/$defs/field" },
        "iban":             { "$ref": "#/$defs/field" },
        "service_type":     { "$ref": "#/$defs/field" },
        "effective_date":   { "$ref": "#/$defs/field" },
        "expiry_date":      { "$ref": "#/$defs/field" },
        "currency":         { "$ref": "#/$defs/field" },
        "mrc":              { "$ref": "#/$defs/money_field" },
        "otc":              { "$ref": "#/$defs/money_field" },
        "subtotal":         { "$ref": "#/$defs/money_field" },
        "tax":              { "$ref": "#/$defs/money_field" },
        "total":            { "$ref": "#/$defs/money_field" },
        "billing_terms":    { "$ref": "#/$defs/field" },
        "notes":            { "$ref": "#/$defs/field" }
      }
    },

    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": { "$ref": "#/$defs/field" },
          "quantity":    { "$ref": "#/$defs/field" },
          "unit_price":  { "$ref": "#/$defs/money_field" },
          "line_total":  { "$ref": "#/$defs/money_field" }
        }
      }
    },

    "gates": {
      "type": "array",
      "description": "Every deterministic validator that ran, and its verdict. Authoritative over the LLM (INV-5).",
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "additionalProperties": false,
        "properties": {
          "name": { "enum": ["iban_checksum", "cnic_format_check", "ntn_format_check", "strn_format_check", "arithmetic_reconciliation", "date_parse", "currency_consistency", "line_item_sum"] },
          "result": {
            "enum": ["passed", "failed", "format_only"],
            "description": "Three states, not two. format_only means the value is well-formed but nothing confirmed it is correct: the identifier carries no checksum. Only iban_checksum, arithmetic_reconciliation, date_parse, line_item_sum and currency_consistency can return passed. cnic_format_check, ntn_format_check and strn_format_check return format_only or failed, never passed."
          },
          "detail": { "type": "string" },
          "affected_fields": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "review": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": "string", "examples": ["gate_failed:arithmetic_reconciliation", "low_confidence:mrc"] },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },

    "timings_ms": {
      "type": "object",
      "properties": {
        "ocr_latin": { "type": "integer" },
        "ocr_urdu": { "type": "integer" },
        "llm": { "type": "integer" },
        "validation": { "type": "integer" },
        "total": { "type": "integer" }
      }
    },

    "created_at": { "type": "string", "format": "date-time" }
  }
}
