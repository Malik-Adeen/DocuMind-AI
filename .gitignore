# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# node
node_modules/
.npm/
.pnpm-store/
*.tsbuildinfo
.next/
.nuxt/
.svelte-kit/
.turbo/

# env
.env
.env.*
