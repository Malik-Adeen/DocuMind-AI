APP_ENV=dev
DEPLOYMENT_PROFILE=prototype
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://ptcl:ptcl@localhost:5432/ptcl
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET=dev-only-insecure-secret-replace-in-every-real-deployment
JWT_EXPIRES_IN=3600

UPLOAD_DIR=./var/uploads
EXPORT_DIR=./var/exports
MAX_UPLOAD_BYTES=26214400

VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_MAX_REPAIR_RETRIES=1

PADDLEOCR_LANG=en
QAARI_MODEL=NAMAA-Space/Qaari-0.1-Urdu

MOCK_STATUS_PROGRESSION_SECONDS=10
