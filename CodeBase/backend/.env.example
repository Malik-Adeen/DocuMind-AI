APP_ENV=dev
DEPLOYMENT_PROFILE=prototype
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://ptcl:ptcl@localhost:5432/ptcl
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET=dev-only-insecure-secret-replace-in-every-real-deployment
JWT_EXPIRES_IN=3600

UPLOAD_DIR=./var/uploads
EXPORT_DIR=./var/exports
MAX_UPLOAD_BYTES=26214400

VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_MAX_REPAIR_RETRIES=1

# prototype profile only (ADR-006/007) — hosted Qwen2.5-7B-Instruct endpoint.
# VLLM_BASE_URL above is production-profile (local vLLM); do not point this at it.
HOSTED_LLM_BASE_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 4000 chosen from measurement, not habit: real completions on a dense document ranged 1340-3201
# output tokens (13 real calls, JOURNAL 2026-08-18). A truncated response is now detected via
# finish_reason and salvaged rather than blindly retried — this bounds cost/latency, it does not
# gate correctness the way it used to.
HOSTED_LLM_MAX_TOKENS=4000
# 20000 is an unmeasured engineering estimate, not a measured budget (ADR-016): Qwen2.5-7B-Instruct's
# native window is 32768 tokens; the fixed prompt template + injected schema is ~3000 tokens; the
# HOSTED_LLM_MAX_TOKENS output reserve above is 4000. Revisit once the deployed vLLM
# --max-model-len is confirmed — this is the knob most likely to need a real measurement.
HOSTED_LLM_MAX_INPUT_TOKENS=20000

# A PDF's page count is checked before OCR starts (ADR-016) — over this cap, the document fails
# DOCUMENT_TOO_LARGE before a single page is rasterized, rather than OCR'ing 200+ pages first.
MAX_PDF_PAGES=50

PADDLEOCR_LANG=en
QAARI_MODEL=oddadmix/Qaari-0.1-Urdu-OCR-VL-2B-Instruct

MOCK_STATUS_PROGRESSION_SECONDS=10
